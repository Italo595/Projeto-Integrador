# Copie para backend/.env e troque os valores (NÃO versione o .env)

PORT=3000

# Segredo do JWT: string longa e aleatória (mín. 16 caracteres)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Chave AES-256: exatamente 64 caracteres hexadecimais.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUARDE UMA CÓPIA: sem ela os dados cifrados não podem ser lidos.
ENC_KEY=

# Identificador do kit no banco (criado na 1ª execução)
DEVICE_ID=LTR701_01

# Banco e esquema (caminhos relativos à pasta backend/)
DB_PATH=../Banco de Dados/integrador.db
SCHEMA_PATH=../Banco de Dados/schema.sql

# Ponte TCP com o MATLAB (use 0.0.0.0 se o MATLAB estiver em outro PC)
TCP_HOST=127.0.0.1
TCP_PORT=2000

# Backups (opcionais)
# BACKUP_DIR=backups
# BACKUP_RETENCAO=14
# BACKUP_CRON=0 3 * * *

# Log em arquivo (opcional)
# LOG_PATH=logs/sistema.log
